# ============================================================================
# Phase 1 configuration. Copy to `.env` and adjust. NEVER commit real .env.
# All paths/URLs/model names come from here — nothing is hardcoded in code.
# ============================================================================

# --- Postgres ---
# Inside docker-compose the host is the service name `postgres`.
# For host-side (no-Docker) runs, point at localhost / your local server.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=audit
POSTGRES_USER=audit
POSTGRES_PASSWORD=audit
# Optional full DSN override; if set it wins over the parts above.
# DATABASE_URL=postgresql+psycopg://audit:audit@localhost:5432/audit

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=paras_v1

# --- Models (offline) ---
# Weights live under MODELS_DIR. In docker we mount ./models -> /models.
# On this Windows host for dev verification, use the absolute local path.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
MODELS_DIR=/models
# Derived paths (override only if your folder names differ):
BGE_M3_PATH=/models/bge-m3
RERANKER_PATH=/models/bge-reranker-v2-m3
# Force CPU inference (Phase 1, one small PDF). Set to cuda if a GPU is present.
EMBED_DEVICE=cpu

# --- Answer LLM (Qwen served externally via vLLM, OpenAI-compatible) ---
# The 32B/8B decision is a one-line change here — never hardcoded in code.
# LLM_API: "openai" (vLLM/prod) or "ollama" (local dev, native API so Qwen3
# thinking can be disabled reliably).
LLM_API=openai
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=EMPTY
MODEL_NAME=Qwen/Qwen3-32B
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_DISABLE_THINKING=true
# Router / intent model (latency-critical, runs every turn). Blank -> uses
# MODEL_NAME. In prod set this to the smaller 8B so routing is cheap while
# answers use the 32B.
ROUTER_MODEL_NAME=
ROUTER_MAX_TOKENS=384
# Ollama-only, dev convenience: "0" unloads the LLM between calls so the BGE
# embedder+reranker fit alongside it on a small-RAM host. Blank = server default.
OLLAMA_KEEP_ALIVE=
# Escape hatch to skip the cross-encoder reranker (use hybrid RRF order). Keep
# false in normal operation.
DISABLE_RERANK=false

# --- Retrieval knobs ---
# --- API (Phase 6A) ---
# Comma-separated API keys checked against X-API-Key. Empty disables auth (dev).
API_KEYS=dev-key-123
# Comma-separated allowed CORS origins (the frontend dev + intranet hosts).
# NEVER "*".
CORS_ORIGINS=http://localhost:3000
API_VERSION=1.0.0

RETRIEVE_TOP_K=20
RERANK_TOP_K=5
CHUNK_TOKENS=800
CHUNK_OVERLAP=100

# --- Ingestion target (Phase 1: exactly one PDF) ---
DATA_DIR=/data
EXCEL_INDEX=/data/Corporate office Para - Sample for database.xlsx
TARGET_PDF=/data/Corporate office IR 2019-20.pdf
TARGET_PERIOD=2019-20
